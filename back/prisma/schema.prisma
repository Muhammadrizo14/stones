generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Stone {
  id                 Int            @id @default(autoincrement())
  title              String
  color              String?
  country            String?
  radioactivityClass String?
  waterAbsorption    String?
  density            String?
  mohsHardness       String?
  structure          Boolean?
  abrasion           String?
  otherNames         String?
  similarGranites    String?
  variants           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  categoryTitle      String?
  mazayka            String?
  seoText            String?        @db.Text
  category           Category?      @relation(fields: [categoryTitle], references: [title])
  uploadedFile       UploadedFile[]

  @@index([categoryTitle], map: "Stone_categoryTitle_fkey")
}

model Reviews {
  id        Int      @id @default(autoincrement())
  name      String
  comment   String   @db.Text
  rate      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Services {
  id            Int            @id @default(autoincrement())
  title         String         @unique
  serviceTitle  String?
  info          String?        @db.Text
  destination   String?
  encoding      String?
  fieldname     String?
  filename      String?        @unique
  mimetype      String?
  originalname  String?
  path          String?
  size          Int?
  interorekster String?
  uploadedFile  UploadedFile[]
}

model Profile {
  id           Int            @id @default(autoincrement())
  title        String
  info         String         @db.Text
  url          String
  uploadedFile UploadedFile[]
}

model Slider {
  id           Int            @id @default(autoincrement())
  uploadedFile UploadedFile[]
}

model Blog {
  id           Int            @id @default(autoincrement())
  title        String         @unique
  blogUrl      String?
  createdAt    DateTime       @default(now())
  text         String?        @db.Text
  uploadedFile UploadedFile[]
}

model Circlestone {
  id           Int            @id @default(autoincrement())
  page         String
  uploadedFile UploadedFile[]
}

model Partners {
  id           Int            @id @default(autoincrement())
  uploadedFile UploadedFile[]
}

model UploadedFile {
  id           Int       @id @default(autoincrement())
  fieldname    String
  originalname String
  encoding     String
  mimetype     String
  destination  String
  filename     String    @unique
  path         String
  size         Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // relations
  serviceTitle  String?
  circlestoneId Int?
  stoneId       Int?
  blogId        Int?
  profileId     Int?
  partnerId     Int?
  sliderId      Int?
  // -------
  Blog          Blog?        @relation(fields: [blogId], references: [id])
  circlestone   Circlestone? @relation(fields: [circlestoneId], references: [id])
  Profile       Profile?     @relation(fields: [profileId], references: [id])
  services      Services?    @relation(fields: [serviceTitle], references: [title], onDelete: Cascade)
  Slider        Slider?      @relation(fields: [sliderId], references: [id])
  Stone         Stone?       @relation(fields: [stoneId], references: [id])
  Partners      Partners?    @relation(fields: [partnerId], references: [id])

  @@index([blogId], map: "UploadedFile_blogId_fkey")
  @@index([circlestoneId], map: "UploadedFile_circlestoneId_fkey")
  @@index([profileId], map: "UploadedFile_profileId_fkey")
  @@index([serviceTitle], map: "UploadedFile_serviceTitle_fkey")
  @@index([sliderId], map: "UploadedFile_sliderId_fkey")
  @@index([stoneId], map: "UploadedFile_stoneId_fkey")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Youtube {
  id  Int    @id @default(autoincrement())
  url String
}

model Category {
  id    Int     @id @default(autoincrement())
  title String  @unique
  stone Stone[]
}
